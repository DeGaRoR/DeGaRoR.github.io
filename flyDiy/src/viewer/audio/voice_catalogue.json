 "id.1": {"file":"media/audio/voice/id_1.f24f62ee.mp3","text":"You're listening to Radio Jolene, ninety point seven, community radio for Jolene Island and the Sound.","dur":7.129},
 "id.2": {"file":"media/audio/voice/id_2.1365c98d.mp3","text":"Radio Jolene, ninety point seven. Your island, your station.","dur":6.545},
 "id.3": {"file":"media/audio/voice/id_3.4aa1ce03.mp3","text":"This is ninety point seven, Radio Jolene, keeping the island and the Sound company.","dur":6.017},
 "bul.intro": {"file":"media/audio/voice/bul_intro.c1e5a303.mp3","text":"Now, around the island.","dur":2.405},
 "bul.mill": {"file":"media/audio/voice/bul_mill.734b7f98.mp3","text":"The mill keeps its hours this week, eight to three.","dur":3.243},
 "bul.tram": {"file":"media/audio/voice/bul_tram.724eca3e.mp3","text":"The tram runs every twenty minutes. The last car leaves at six.","dur":4.719},
 "bul.ferry": {"file":"media/audio/voice/bul_ferry.a276f59c.mp3","text":"The ferry sails Thursday, weather permitting. Get your freight to the dock by Wednesday noon.","dur":5.862},
 "bul.fuel": {"file":"media/audio/voice/bul_fuel.cae164bb.mp3","text":"The fuel dock has diesel and avgas.","dur":2.744},
 "bul.potluck": {"file":"media/audio/voice/bul_potluck.981e158e.mp3","text":"Potluck at the hall, Friday at six. Bring a dish.","dur":4.844},
 "bul.coho": {"file":"media/audio/voice/bul_coho.f64a5ba7.mp3","text":"The coho are in off the point. Keep the channel clear for the barge.","dur":4.42},
 "bul.library": {"file":"media/audio/voice/bul_library.80d1727b.mp3","text":"And the library stays open late on Tuesdays.","dur":2.963},
 "pil.intro": {"file":"media/audio/voice/pil_intro.69d53760.mp3","text":"A few notes for pilots.","dur":1.846},
 "pil.tamgas": {"file":"media/audio/voice/pil_tamgas.f61e602f.mp3","text":"The Tamgas Hill strip is soft after the rain. Land uphill, take off downhill.","dur":5.657},
 "pil.seaplane": {"file":"media/audio/voice/pil_seaplane.360372b4.mp3","text":"The seaplane lane is active off the breakwater.","dur":2.689},
 "pil.birds": {"file":"media/audio/voice/pil_birds.391c4116.mp3","text":"Eagles and gulls at the end of runway one three.","dur":3.752},
