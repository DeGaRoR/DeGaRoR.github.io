 "bulletin.mill": {"file":"media/audio/voice/bulletin_mill.28b4208c.mp3","text":"The sawmill at the head of the bay is on winter hours from Monday: seven in the morning till half past three, closed Sundays.","dur":6.67},
 "bulletin.tram": {"file":"media/audio/voice/bulletin_tram.c502d355.mp3","text":"The mine tram runs every half hour from the harbour road. The last car down leaves the top at a quarter past six.","dur":6.525},
 "bulletin.ferry": {"file":"media/audio/voice/bulletin_ferry.c857aee7.mp3","text":"The mainland ferry is running about forty minutes behind. If you are meeting someone, the coffee at the terminal is on.","dur":5.817},
 "bulletin.fuel": {"file":"media/audio/voice/bulletin_fuel.6d13b084.mp3","text":"The fuel dock has avgas and marine diesel again. Cash or the club card, and mind the new float on the north side.","dur":7.029},
 "bulletin.potluck": {"file":"media/audio/voice/bulletin_potluck.780ae3df.mp3","text":"Potluck at the community hall on Saturday at six. Bring a dish, bring a chair, bring your cousin.","dur":6.131},
 "bulletin.coho": {"file":"media/audio/voice/bulletin_coho.290367a5.mp3","text":"The coho are running at the creek mouth. Skiffs, please keep clear of the seaplane lane while you fish.","dur":5.972},
 "bulletin.library": {"file":"media/audio/voice/bulletin_library.6081d010.mp3","text":"The library is open late on Thursday, until eight. Overdue books forgiven if you bring them back with a story.","dur":5.717},
 "swap.floats": {"file":"media/audio/voice/swap_floats.6a176c41.mp3","text":"A set of float rigging for a Cub, needs new cables. Will trade for a chainsaw that runs. Ask at the boat shed.","dur":6.934},
 "swap.tailwheel": {"file":"media/audio/voice/swap_tailwheel.f995ee90.mp3","text":"For sale: a tailwheel, nearly round, and a crab pot, nearly square. Both at the fuel dock.","dur":5.757},
 "swap.carb": {"file":"media/audio/voice/swap_carb.a60fb17d.mp3","text":"Wanted: someone who can rebuild a carburettor and will not laugh at mine. Leave a note on the hangar door.","dur":5.238},
 "swap.skiff": {"file":"media/audio/voice/swap_skiff.f3984a29.mp3","text":"Free to a good home: a fourteen foot skiff with a little rain in it. The oars are the good part.","dur":4.799},
