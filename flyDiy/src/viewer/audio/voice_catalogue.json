 "swap.intro": {"file":"media/audio/voice/swap_intro.2fe0c33a.mp3","text":"Time for the swap corner.","dur":1.776},
 "swap.outboard": {"file":"media/audio/voice/swap_outboard.e3c0844a.mp3","text":"For sale, a fifteen horse outboard. Ask for Ray at the fuel dock.","dur":6.401},
 "swap.cub": {"file":"media/audio/voice/swap_cub.54c24ae4.mp3","text":"Wanted, a Cub tailwheel spring. Will trade smoked salmon.","dur":5.667},
