 "bulletin.mill": {"file":"media/audio/voice/bulletin_mill.fd2940dd.mp3","text":"The sawmill at the head of the bay is on winter hours from Monday: seven in the morning till half past three, closed Sundays.","dur":6.7},
 "bulletin.tram": {"file":"media/audio/voice/bulletin_tram.9854eba2.mp3","text":"The mine tram runs every half hour from the harbour road. The last car down leaves the top at a quarter past six.","dur":6.326},
 "bulletin.ferry": {"file":"media/audio/voice/bulletin_ferry.f963cd6c.mp3","text":"The mainland ferry is running about forty minutes behind. If you are meeting someone, the coffee at the terminal is on.","dur":6.191},
 "bulletin.fuel": {"file":"media/audio/voice/bulletin_fuel.4a5c7c5b.mp3","text":"The fuel dock has avgas and marine diesel again. Cash or the club card, and mind the new float on the north side.","dur":7.264},
 "bulletin.potluck": {"file":"media/audio/voice/bulletin_potluck.4f644067.mp3","text":"Potluck at the community hall on Saturday at six. Bring a dish, bring a chair, bring your cousin.","dur":6.436},
 "bulletin.coho": {"file":"media/audio/voice/bulletin_coho.5dbfc5f6.mp3","text":"The coho are running at the creek mouth. Skiffs, please keep clear of the seaplane lane while you fish.","dur":5.967},
 "bulletin.library": {"file":"media/audio/voice/bulletin_library.7a1b40e4.mp3","text":"The library is open late on Thursday, until eight. Overdue books forgiven if you bring them back with a story.","dur":5.782},
 "swap.floats": {"file":"media/audio/voice/swap_floats.c199e916.mp3","text":"A set of float rigging for a Cub, needs new cables. Will trade for a chainsaw that runs. Ask at the boat shed.","dur":7.059},
 "swap.tailwheel": {"file":"media/audio/voice/swap_tailwheel.7f92a163.mp3","text":"For sale: a tailwheel, nearly round, and a crab pot, nearly square. Both at the fuel dock.","dur":6.406},
 "swap.carb": {"file":"media/audio/voice/swap_carb.5b916888.mp3","text":"Wanted: someone who can rebuild a carburettor and will not laugh at mine. Leave a note on the hangar door.","dur":5.049},
 "swap.skiff": {"file":"media/audio/voice/swap_skiff.22b2dd76.mp3","text":"Free to a good home: a fourteen foot skiff with a little rain in it. The oars are the good part.","dur":4.784},
